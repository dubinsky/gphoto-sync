#!/bin/sh
# Front door for this checkout. Serve.spawnServe does not call this script.
# Gradle selects the build from the client cwd. Pass --project-dir. Do not cd.
# APP_HOME only finds gradle-wrapper.jar.
# JavaExec.setArgsString in Gradle 9.8.2 parses --args with
# org.codehaus.plexus.util.cli.CommandLineUtils.translateCommandline
# (plexus-utils 3.6.1). Space splits. Quotes group. A backslash is not an
# escape. An empty argument cannot be encoded, so it is refused.
# photo shell does not use that path. JavaExec pipes stdin and stdout, so the
# program has no console and sees EOF at once. The shell runs photoRuntime,
# then execs that java with the terminal inherited. Tab completion needs it.
set -eu

case $0 in
  */*) invoked=$0 ;;
  *)
    invoked=$(command -v -- "$0") || {
      printf '%s\n' "photo: not on PATH: $0" >&2
      exit 1
    }
    ;;
esac

script=$(readlink -f -- "$invoked") || {
  printf '%s\n' "photo: cannot resolve $invoked" >&2
  exit 1
}
root=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd -P)
gradlew=$root/gradlew

if [ ! -f "$root/settings.gradle" ] || [ ! -x "$gradlew" ]; then
  printf '%s\n' "photo: $root is not the gphoto-sync checkout" >&2
  exit 1
fi

# One Plexus-quoted argument. Always ends with a single quote, so $(...) is safe.
quote_arg() {
  printf "'"
  rest=$1
  while [ -n "$rest" ]; do
    case "$rest" in
      \'*)
        printf '%s' "'\"'\"'"
        rest=${rest#\'}
        ;;
      *)
        prefix=${rest%%\'*}
        printf '%s' "$prefix"
        rest=${rest#"$prefix"}
        ;;
    esac
  done
  printf "'"
}

encoded=
sep=
for arg in "$@"; do
  if [ -z "$arg" ]; then
    printf '%s\n' "photo: empty argument cannot be passed through gradle run --args" >&2
    exit 1
  fi
  piece=$(quote_arg "$arg")
  encoded=$encoded$sep$piece
  sep=' '
done

# Print mode's java line is the word java. The real binary is line 1 of the runtime file.
if [ "${1:-}" = "shell" ]; then
  if [ "${PHOTO_LAUNCHER_PRINT_ARGS:-}" = 1 ]; then
    printf '%s\n' "$gradlew"
    printf '%s\n' "--project-dir=$root"
    printf '%s\n' "photoRuntime"
    printf '%s\n' "java"
    printf '%s\n' "--enable-native-access=ALL-UNNAMED"
    printf '%s\n' "org.podval.tools.photo.Cli"
    for arg in "$@"; do
      printf '%s\n' "$arg"
    done
    exit 0
  fi

  "$gradlew" --quiet --console=plain --project-dir "$root" photoRuntime
  runtime=$root/build/photo-runtime.txt
  if [ ! -f "$runtime" ]; then
    printf '%s\n' "photo: missing $runtime" >&2
    exit 1
  fi
  java_bin=
  class_path=
  line_no=0
  while IFS= read -r line || [ -n "$line" ]; do
    line_no=$((line_no + 1))
    case $line_no in
      1) java_bin=$line ;;
      2) class_path=$line ;;
      *)
        printf '%s\n' "photo: $runtime has extra lines" >&2
        exit 1
        ;;
    esac
  done < "$runtime"
  if [ -z "$java_bin" ] || [ ! -x "$java_bin" ]; then
    printf '%s\n' "photo: java from $runtime is not executable" >&2
    exit 1
  fi
  if [ -z "$class_path" ]; then
    printf '%s\n' "photo: classpath from $runtime is empty" >&2
    exit 1
  fi
  # JLine's terminal calls MemorySegment.reinterpret. Without this, Java 25 warns and a later JDK blocks it.
  PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 CLASSPATH="$class_path" \
    exec "$java_bin" --enable-native-access=ALL-UNNAMED org.podval.tools.photo.Cli "$@"
fi

if [ "${PHOTO_LAUNCHER_PRINT_ARGS:-}" = 1 ]; then
  printf '%s\n' "$gradlew"
  printf '%s\n' "--project-dir=$root"
  if [ -n "$encoded" ]; then
    printf '%s\n' "--args=$encoded"
  fi
  exit 0
fi

if [ -n "$encoded" ]; then
  exec "$gradlew" --quiet --console=plain --project-dir "$root" run "--args=$encoded"
else
  exec "$gradlew" --quiet --console=plain --project-dir "$root" run
fi
